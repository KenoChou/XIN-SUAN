/* XIN-SUAN · Cream editorial design system */
page{background:#F8F5EF;color:#343C34;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Helvetica Neue",sans-serif;font-size:28rpx;line-height:1.6;letter-spacing:.2rpx}
view,text,button,input,picker{box-sizing:border-box}
button{margin:0;padding:0;border:0;background:transparent;line-height:inherit}
button:after{border:0}
.page{padding:34rpx 32rpx 56rpx}
.page-title{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:42rpx;line-height:1.3;font-weight:700;letter-spacing:-.8rpx;color:#303A32}
.page-subtitle{margin-top:10rpx;color:#8B887D;font-size:24rpx;line-height:1.6}
.section{margin-top:38rpx}
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}
.section-title{font-size:30rpx;font-weight:650;letter-spacing:-.3rpx;color:#374238}
.muted{color:#8B887D}
.small{font-size:22rpx}
.card{background:#FFFEFB;border:1rpx solid #EEE8DC;border-radius:26rpx;padding:28rpx;box-shadow:0 7rpx 24rpx rgba(78,67,45,.035)}
.field-label{color:#858477;font-size:24rpx;margin-bottom:12rpx}
.field-input{width:100%;height:88rpx;background:#F5F1E8;border:1rpx solid #EFE8DB;border-radius:16rpx;padding:0 22rpx;font-size:30rpx;color:#343C34}
.field-row{display:flex;gap:18rpx}
.field-col{flex:1;min-width:0}
.primary-btn{height:92rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;color:#FFFEFB;background:#55745B;font-size:30rpx;font-weight:650;margin-top:24rpx;box-shadow:0 8rpx 18rpx rgba(85,116,91,.13)}
.secondary-btn{height:78rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;color:#55745B;background:#E9EDE2;font-size:27rpx;font-weight:600}
.pill{display:inline-flex;padding:8rpx 16rpx;border-radius:999rpx;background:#E9EDE2;color:#55745B;font-size:21rpx}
.divider{height:1rpx;background:#EEE8DC;margin:24rpx 0}
.row-between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}
.link{color:#648067;font-size:24rpx}
.tag{background:#F0E8D9;color:#89806D;padding:7rpx 13rpx;border-radius:999rpx;font-size:21rpx}
input::placeholder{color:#B6B0A3}

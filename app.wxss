page{background:#F7F8F6;color:#202522;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.5}view,text,button,input,picker{box-sizing:border-box}button{margin:0;padding:0;border:0;background:transparent;line-height:inherit}button:after{border:0}.page{padding:28rpx 30rpx 48rpx}.page-title{font-size:42rpx;font-weight:700}.page-subtitle{margin-top:8rpx;color:#7B827F;font-size:24rpx}.section{margin-top:30rpx}.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx}.section-title{font-size:30rpx;font-weight:650}.muted{color:#7B827F}.small{font-size:22rpx}.card{background:#fff;border-radius:24rpx;padding:26rpx;box-shadow:0 8rpx 28rpx rgba(27,46,37,.035)}.field-label{color:#6F7772;font-size:24rpx;margin-bottom:12rpx}.field-input{width:100%;height:88rpx;background:#F7F8F6;border-radius:14rpx;padding:0 22rpx;font-size:30rpx;color:#202522}.field-row{display:flex;gap:18rpx}.field-col{flex:1;min-width:0}.primary-btn{height:92rpx;display:flex;align-items:center;justify-content:center;border-radius:18rpx;color:white;background:#167B63;font-size:30rpx;font-weight:650;margin-top:24rpx}.secondary-btn{height:78rpx;display:flex;align-items:center;justify-content:center;border-radius:16rpx;color:#167B63;background:#EAF4EF;font-size:27rpx;font-weight:600}.pill{display:inline-flex;padding:8rpx 16rpx;border-radius:999rpx;background:#EAF4EF;color:#167B63;font-size:21rpx}.divider{height:1rpx;background:#EEF0ED;margin:22rpx 0}.row-between{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.link{color:#167B63;font-size:24rpx}.tag{background:#F0F2EF;color:#69716C;padding:7rpx 13rpx;border-radius:8rpx;font-size:21rpx}
.hero-head{display:flex;justify-content:space-between;align-items:center;margin:8rpx 0 28rpx}.brand-mark{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:24rpx;color:#fff;background:#167B63;font-size:38rpx;font-weight:700}.salary-card{background:#173E34;border-radius:28rpx;padding:30rpx;color:#fff;box-shadow:0 16rpx 34rpx rgba(21,62,51,.12)}.eyebrow{font-size:24rpx;color:rgba(255,255,255,.72)}.gross-line{display:flex;align-items:center;border-bottom:1rpx solid rgba(255,255,255,.18);padding:12rpx 0 24rpx}.yuan{font-size:38rpx;margin-right:12rpx;color:#C5E4D5}.gross-input{color:#fff;font-size:58rpx;font-weight:700;height:82rpx;flex:1;min-width:0}.salary-meta{display:flex;gap:50rpx;margin-top:24rpx}.meta-item{display:flex;flex-direction:column;gap:8rpx}.meta-label{font-size:22rpx;color:rgba(255,255,255,.62)}.picker-value{color:#fff;font-size:27rpx;font-weight:600}.advanced{margin-top:24rpx}.extra-row{margin-top:20rpx}.hint{margin-top:18rpx;color:#8A918D;font-size:21rpx;line-height:1.6}.tool-grid{display:flex;gap:18rpx}.tool-card{flex:1;background:#fff;border-radius:22rpx;padding:24rpx;min-width:0}.tool-icon{width:58rpx;height:58rpx;border-radius:18rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700;margin-bottom:18rpx}.mint{background:#E7F4ED;color:#167B63}.peach{background:#FFF0E2;color:#C67B3B}.tool-name{font-size:27rpx;font-weight:650}.tool-desc{font-size:21rpx;color:#8A918D;margin-top:8rpx}.footer-note{text-align:center;color:#9AA09C;font-size:21rpx;padding:32rpx 8rpx 12rpx}
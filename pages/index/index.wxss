.hero-head{display:flex;justify-content:space-between;align-items:center;margin:8rpx 0 30rpx}.brand-mark{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:25rpx;color:#55745B;background:#E4E9D9;font-size:38rpx;font-weight:700}.salary-card{background:#E9EDE2;border:1rpx solid #DDE4D5;border-radius:30rpx;padding:32rpx;color:#374238;box-shadow:0 12rpx 30rpx rgba(85,116,91,.08)}.eyebrow{font-size:24rpx;color:#747F6E}.gross-line{display:flex;align-items:center;border-bottom:1rpx solid #D6DECF;padding:12rpx 0 24rpx}.yuan{font-size:38rpx;margin-right:12rpx;color:#55745B}.gross-input{color:#303A32;font-size:58rpx;font-weight:700;height:82rpx;flex:1;min-width:0}.salary-meta{display:flex;gap:50rpx;margin-top:24rpx}.meta-item{display:flex;flex-direction:column;gap:8rpx}.meta-label{font-size:22rpx;color:#858D7C}.picker-value{color:#3E5140;font-size:27rpx;font-weight:600}.advanced{margin-top:24rpx}.extra-row{margin-top:20rpx}.hint{margin-top:18rpx;color:#969184;font-size:21rpx;line-height:1.7}.tool-grid{display:flex;gap:18rpx}.tool-card{flex:1;background:#FFFEFB;border:1rpx solid #EEE8DC;border-radius:24rpx;padding:24rpx;min-width:0;box-shadow:0 6rpx 18rpx rgba(78,67,45,.025)}.tool-icon{width:58rpx;height:58rpx;border-radius:19rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700;margin-bottom:18rpx}.mint{background:#E4E9D9;color:#55745B}.peach{background:#F5E4D5;color:#A96E4A}.tool-name{font-size:27rpx;font-weight:650;color:#3B4339}.tool-desc{font-size:21rpx;color:#969184;margin-top:8rpx}.footer-note{text-align:center;color:#A29D91;font-size:21rpx;padding:34rpx 8rpx 12rpx}.salary-meta{gap:20rpx;margin-top:28rpx}.meta-item{flex:1;min-width:0;gap:10rpx}.meta-label{padding-left:4rpx}.selector-control{height:76rpx;padding:0 18rpx 0 20rpx;border:1rpx solid #D7DFD0;border-radius:17rpx;background:rgba(255,254,251,.78);display:flex;align-items:center;justify-content:space-between;gap:8rpx;box-shadow:0 3rpx 9rpx rgba(69,89,63,.025)}.selector-value{font-size:27rpx;font-weight:650;color:#3E5140;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.selector-unit{margin-left:3rpx}.selector-arrow{width:32rpx;height:32rpx;flex-shrink:0;border-radius:50%;background:#E9EDE2;color:#648067;font-size:25rpx;line-height:28rpx;text-align:center}.selector-mask{position:fixed;z-index:99;left:0;right:0;top:0;bottom:0;background:rgba(42,47,39,.34);display:flex;align-items:flex-end}.selector-sheet{width:100%;background:#FFFEFB;border-radius:32rpx 32rpx 0 0;padding:16rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));box-shadow:0 -12rpx 50rpx rgba(50,48,39,.1);animation:sheet-rise .2s ease-out}.sheet-handle{width:68rpx;height:7rpx;border-radius:99rpx;background:#E6E1D7;margin:0 auto 26rpx}.sheet-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.sheet-title{font-size:34rpx;font-weight:700;color:#343C34;letter-spacing:-.5rpx}.sheet-subtitle{font-size:22rpx;color:#969184;margin-top:5rpx}.sheet-close{width:54rpx;height:54rpx;border-radius:50%;background:#F5F1E8;color:#77796E;text-align:center;line-height:48rpx;font-size:40rpx}.option-list{display:flex;flex-wrap:wrap;gap:14rpx}.option-item{width:calc((100% - 28rpx) / 3);min-height:78rpx;padding:0 16rpx;border:1rpx solid #EEE8DC;border-radius:17rpx;background:#FAF7F1;display:flex;align-items:center;justify-content:center;gap:8rpx;color:#65685D}.option-label{font-size:26rpx;font-weight:550}.option-selected{background:#E9EDE2;border-color:#AEBEA5;color:#55745B;font-weight:650}.option-check{font-size:23rpx;font-weight:700}.sheet-footnote{font-size:21rpx;color:#A29D91;line-height:1.7;margin-top:24rpx;padding-top:18rpx;border-top:1rpx solid #F0EBE2}@keyframes sheet-rise{from{transform:translateY(30rpx);opacity:.65}to{transform:translateY(0);opacity:1}}
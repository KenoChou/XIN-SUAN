.hero-head{display:flex;justify-content:space-between;align-items:center;margin:8rpx 0 30rpx}.brand-mark{width:76rpx;height:76rpx;display:flex;align-items:center;justify-content:center;border-radius:25rpx;color:#55745B;background:#E4E9D9;font-size:38rpx;font-weight:700}.salary-card{background:#E9EDE2;border:1rpx solid #DDE4D5;border-radius:30rpx;padding:32rpx;color:#374238;box-shadow:0 12rpx 30rpx rgba(85,116,91,.08)}.eyebrow{font-size:24rpx;color:#747F6E}.gross-line{display:flex;align-items:center;border-bottom:1rpx solid #D6DECF;padding:12rpx 0 24rpx}.yuan{font-size:38rpx;margin-right:12rpx;color:#55745B}.gross-input{color:#303A32;font-size:58rpx;font-weight:700;height:82rpx;flex:1;min-width:0}.salary-meta{display:flex;gap:50rpx;margin-top:24rpx}.meta-item{display:flex;flex-direction:column;gap:8rpx}.meta-label{font-size:22rpx;color:#858D7C}.picker-value{color:#3E5140;font-size:27rpx;font-weight:600}.advanced{margin-top:24rpx}.extra-row{margin-top:20rpx}.hint{margin-top:18rpx;color:#969184;font-size:21rpx;line-height:1.7}.tool-grid{display:flex;gap:18rpx}.tool-card{flex:1;background:#FFFEFB;border:1rpx solid #EEE8DC;border-radius:24rpx;padding:24rpx;min-width:0;box-shadow:0 6rpx 18rpx rgba(78,67,45,.025)}.tool-icon{width:58rpx;height:58rpx;border-radius:19rpx;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700;margin-bottom:18rpx}.mint{background:#E4E9D9;color:#55745B}.peach{background:#F5E4D5;color:#A96E4A}.tool-name{font-size:27rpx;font-weight:650;color:#3B4339}.tool-desc{font-size:21rpx;color:#969184;margin-top:8rpx}.footer-note{text-align:center;color:#A29D91;font-size:21rpx;padding:34rpx 8rpx 12rpx}
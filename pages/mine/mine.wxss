.profile-card{background:#173E34;border-radius:26rpx;padding:36rpx 28rpx;text-align:center;color:#fff}.profile-mark{width:84rpx;height:84rpx;margin:0 auto 16rpx;border-radius:26rpx;background:#D9EEE3;color:#167B63;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:750}.profile-name{font-size:34rpx;font-weight:700}.profile-desc{color:rgba(255,255,255,.7);font-size:23rpx;margin-top:6rpx}.version{margin:20rpx auto 0;display:table;padding:7rpx 14rpx;border-radius:999rpx;background:rgba(255,255,255,.1);color:#D9EEE3;font-size:20rpx}.history-list,.settings-card{background:#fff;border-radius:22rpx;padding:0 24rpx;margin-top:16rpx}.history-item{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #EEF0ED}.history-title{font-size:25rpx;font-weight:600}.history-date,.history-caption{font-size:21rpx;color:#909892;margin-top:6rpx}.history-right{text-align:right}.history-net{color:#167B63;font-size:28rpx;font-weight:700}.empty-card{background:#fff;border-radius:22rpx;padding:34rpx 24rpx;text-align:center;margin-top:16rpx}.empty-icon{margin:0 auto 12rpx;width:62rpx;height:62rpx;border-radius:20rpx;background:#EAF4EF;color:#167B63;display:flex;align-items:center;justify-content:center;font-size:32rpx}.empty-title{font-size:27rpx;font-weight:650}.empty-desc{font-size:22rpx;color:#8A918D;margin-top:8rpx}.empty-btn{margin-top:22rpx}.setting-row{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #EEF0ED;font-size:26rpx}.setting-row:last-child{border-bottom:none}.chevron{font-size:38rpx;color:#B0B7B2}
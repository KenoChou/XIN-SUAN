.profile-card{background:#E9EDE2;border:1rpx solid #DDE4D5;border-radius:30rpx;padding:36rpx 28rpx;text-align:center;color:#374238}.profile-mark{width:84rpx;height:84rpx;margin:0 auto 16rpx;border-radius:27rpx;background:#55745B;color:#FFFEFB;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:750}.profile-name{font-size:34rpx;font-weight:700}.profile-desc{color:#7C8675;font-size:23rpx;margin-top:6rpx}.version{margin:20rpx auto 0;display:table;padding:7rpx 14rpx;border-radius:999rpx;background:#DDE4D5;color:#64755F;font-size:20rpx}.history-list,.settings-card{background:#FFFEFB;border:1rpx solid #EEE8DC;border-radius:24rpx;padding:0 24rpx;margin-top:16rpx}.history-item{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #F0EBE2}.history-title{font-size:25rpx;font-weight:600;color:#3B4339}.history-date,.history-caption{font-size:21rpx;color:#969184;margin-top:6rpx}.history-right{text-align:right}.history-net{color:#55745B;font-size:28rpx;font-weight:700}.empty-card{background:#FFFEFB;border:1rpx solid #EEE8DC;border-radius:24rpx;padding:34rpx 24rpx;text-align:center;margin-top:16rpx}.empty-icon{margin:0 auto 12rpx;width:62rpx;height:62rpx;border-radius:20rpx;background:#E9EDE2;color:#55745B;display:flex;align-items:center;justify-content:center;font-size:32rpx}.empty-title{font-size:27rpx;font-weight:650;color:#3B4339}.empty-desc{font-size:22rpx;color:#969184;margin-top:8rpx}.empty-btn{margin-top:22rpx}.setting-row{display:flex;align-items:center;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid #F0EBE2;font-size:26rpx;color:#4A5147}.setting-row:last-child{border-bottom:none}.chevron{font-size:38rpx;color:#B6B0A3}
.offer-switch{display:flex;padding:7rpx;background:#E9ECE8;border-radius:16rpx;margin:28rpx 0 20rpx}.switch-item{flex:1;text-align:center;padding:18rpx;border-radius:12rpx;color:#747C76;font-weight:600}.switch-item.active{color:#167B63;background:#fff;box-shadow:0 3rpx 10rpx rgba(0,0,0,.04)}.offer-form{padding:28rpx}.top-label{margin-top:24rpx}.top-fields{margin-top:20rpx}.picker{display:flex;align-items:center;font-size:27rpx}.calc-btn{margin-top:26rpx}.compare-total{display:flex;gap:18rpx}.compare-col{flex:1;min-width:0}.compare-money{font-size:30rpx;font-weight:750;color:#167B63;margin-top:10rpx;word-break:break-all}.difference{font-size:29rpx;font-weight:700;color:#167B63}.winner{margin-top:18rpx;padding:18rpx;border-radius:14rpx;background:#EAF4EF;color:#167B63;font-weight:650;text-align:center}.result-note{display:block;line-height:1.7;margin-top:20rpx}.tip-card{display:flex;gap:18rpx;padding:24rpx;border-radius:20rpx;background:#fff;margin-top:16rpx}.tip-icon{width:54rpx;height:54rpx;border-radius:16rpx;background:#FFF0E2;color:#C67B3B;display:flex;align-items:center;justify-content:center;font-size:30rpx}.tip-title{font-size:27rpx;font-weight:650}.tip-desc{font-size:23rpx;color:#818984;margin-top:6rpx;line-height:1.6}
.offer-switch{display:flex;padding:7rpx;background:#EFE9DE;border-radius:18rpx;margin:28rpx 0 20rpx}.switch-item{flex:1;text-align:center;padding:18rpx;border-radius:14rpx;color:#8B887D;font-weight:600}.switch-item.active{color:#55745B;background:#FFFEFB;box-shadow:0 4rpx 12rpx rgba(78,67,45,.06)}.offer-form{padding:28rpx}.top-label{margin-top:24rpx}.top-fields{margin-top:20rpx}.picker{display:flex;align-items:center;font-size:27rpx}.calc-btn{margin-top:26rpx}.compare-total{display:flex;gap:18rpx}.compare-col{flex:1;min-width:0}.compare-money{font-size:30rpx;font-weight:750;color:#55745B;margin-top:10rpx;word-break:break-all}.difference{font-size:29rpx;font-weight:700;color:#55745B}.winner{margin-top:18rpx;padding:18rpx;border-radius:16rpx;background:#E9EDE2;color:#55745B;font-weight:650;text-align:center}.result-note{display:block;line-height:1.7;margin-top:20rpx}.tip-card{display:flex;gap:18rpx;padding:24rpx;border:1rpx solid #EEE8DC;border-radius:22rpx;background:#FFFEFB;margin-top:16rpx}.tip-icon{width:54rpx;height:54rpx;flex-shrink:0;border-radius:17rpx;background:#F5E4D5;color:#A96E4A;display:flex;align-items:center;justify-content:center;font-size:30rpx}.tip-title{font-size:27rpx;font-weight:650;color:#3B4339}.tip-desc{font-size:23rpx;color:#8B887D;margin-top:6rpx;line-height:1.7}
.offer-switch{display:flex;padding:7rpx;background:#EFE9DE;border-radius:18rpx;margin:28rpx 0 20rpx}.switch-item{flex:1;text-align:center;padding:18rpx;border-radius:14rpx;color:#8B887D;font-weight:600}.switch-item.active{color:#55745B;background:#FFFEFB;box-shadow:0 4rpx 12rpx rgba(78,67,45,.06)}.offer-form{padding:28rpx}.top-label{margin-top:24rpx}.top-fields{margin-top:20rpx}.picker{display:flex;align-items:center;font-size:27rpx}.calc-btn{margin-top:26rpx}.compare-total{display:flex;gap:18rpx}.compare-col{flex:1;min-width:0}.compare-money{font-size:30rpx;font-weight:750;color:#55745B;margin-top:10rpx;word-break:break-all}.difference{font-size:29rpx;font-weight:700;color:#55745B}.winner{margin-top:18rpx;padding:18rpx;border-radius:16rpx;background:#E9EDE2;color:#55745B;font-weight:650;text-align:center}.result-note{display:block;line-height:1.7;margin-top:20rpx}.tip-card{display:flex;gap:18rpx;padding:24rpx;border:1rpx solid #EEE8DC;border-radius:22rpx;background:#FFFEFB;margin-top:16rpx}.tip-icon{width:54rpx;height:54rpx;flex-shrink:0;border-radius:17rpx;background:#F5E4D5;color:#A96E4A;display:flex;align-items:center;justify-content:center;font-size:30rpx}.tip-title{font-size:27rpx;font-weight:650;color:#3B4339}.tip-desc{font-size:23rpx;color:#8B887D;margin-top:6rpx;line-height:1.7}.offer-select{display:flex;align-items:center;justify-content:space-between;gap:8rpx;background:#F5F1E8;border-color:#E9E1D4;color:#3E5140;font-size:27rpx;font-weight:600}.select-city{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.select-chevron{flex-shrink:0;width:32rpx;height:32rpx;border-radius:50%;background:#E9EDE2;color:#648067;text-align:center;line-height:28rpx;font-size:25rpx}.selector-mask{position:fixed;z-index:99;left:0;right:0;top:0;bottom:0;background:rgba(42,47,39,.34);display:flex;align-items:flex-end}.selector-sheet{width:100%;background:#FFFEFB;border-radius:32rpx 32rpx 0 0;padding:16rpx 32rpx calc(30rpx + env(safe-area-inset-bottom));box-shadow:0 -12rpx 50rpx rgba(50,48,39,.1);animation:sheet-rise .2s ease-out}.sheet-handle{width:68rpx;height:7rpx;border-radius:99rpx;background:#E6E1D7;margin:0 auto 26rpx}.sheet-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:22rpx}.sheet-title{font-size:34rpx;font-weight:700;color:#343C34;letter-spacing:-.5rpx}.sheet-subtitle{font-size:22rpx;color:#969184;margin-top:5rpx}.sheet-close{width:54rpx;height:54rpx;border-radius:50%;background:#F5F1E8;color:#77796E;text-align:center;line-height:48rpx;font-size:40rpx}.option-list{display:flex;flex-wrap:wrap;gap:14rpx}.option-item{width:calc((100% - 28rpx) / 3);min-height:78rpx;padding:0 16rpx;border:1rpx solid #EEE8DC;border-radius:17rpx;background:#FAF7F1;display:flex;align-items:center;justify-content:center;gap:8rpx;color:#65685D}.option-label{font-size:26rpx;font-weight:550}.option-selected{background:#E9EDE2;border-color:#AEBEA5;color:#55745B;font-weight:650}.option-check{font-size:23rpx;font-weight:700}.sheet-footnote{font-size:21rpx;color:#A29D91;line-height:1.7;margin-top:24rpx;padding-top:18rpx;border-top:1rpx solid #F0EBE2}@keyframes sheet-rise{from{transform:translateY(30rpx);opacity:.65}to{transform:translateY(0);opacity:1}}
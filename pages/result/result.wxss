.result-label{text-align:center;margin-top:30rpx;color:#68736D;font-size:26rpx}.result-amount{text-align:center;margin-top:8rpx;color:#167B63;font-size:66rpx;font-weight:750}.result-caption{text-align:center;color:#8A918D;font-size:23rpx;margin-top:10rpx}.annual-card{margin-top:32rpx;background:#173E34;border-radius:24rpx;padding:28rpx;color:#fff;display:flex;align-items:center;justify-content:space-between}.annual-label{color:rgba(255,255,255,.7);font-size:23rpx}.annual-value{font-size:36rpx;font-weight:700;margin-top:6rpx}.annual-chip{padding:8rpx 14rpx;background:rgba(255,255,255,.12);border-radius:10rpx;color:#D7EDE2;font-size:21rpx}.breakdown-row{display:flex;align-items:center;margin:16rpx 0}.dot{width:14rpx;height:14rpx;border-radius:50%;margin-right:14rpx}.net-dot{background:#167B63}.tax-dot{background:#E9A15D}.social-dot{background:#80B5A0}.house-dot{background:#A7B4AD}.break-label{flex:1;color:#606963;font-size:25rpx}.break-value{font-size:26rpx;font-weight:600}.bar-track{height:12rpx;background:#EEF1ED;border-radius:99rpx;overflow:hidden;margin:8rpx 0 24rpx}.bar-fill{height:100%;background:#167B63;border-radius:99rpx}.detail-row{display:flex;justify-content:space-between;padding:15rpx 0;color:#69716C;font-size:25rpx}.detail-row text:last-child{color:#252B27;font-weight:550}.detail-row.total{font-size:28rpx;font-weight:700}.detail-row.total text{color:#167B63}.notice{color:#8A918D;font-size:21rpx;line-height:1.7;padding:22rpx 4rpx}.save-btn{margin-top:16rpx}
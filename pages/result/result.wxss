.result-label{text-align:center;margin-top:30rpx;color:#858477;font-size:26rpx}.result-amount{text-align:center;margin-top:8rpx;color:#55745B;font-size:66rpx;font-weight:750;letter-spacing:-1rpx}.result-caption{text-align:center;color:#969184;font-size:23rpx;margin-top:10rpx}.annual-card{margin-top:32rpx;background:#E9EDE2;border:1rpx solid #DDE4D5;border-radius:26rpx;padding:28rpx;color:#374238;display:flex;align-items:center;justify-content:space-between}.annual-label{color:#7C8675;font-size:23rpx}.annual-value{font-size:36rpx;font-weight:700;margin-top:6rpx;color:#3D5140}.annual-chip{padding:8rpx 14rpx;background:#DDE4D5;border-radius:999rpx;color:#64755F;font-size:21rpx}.breakdown-row{display:flex;align-items:center;margin:16rpx 0}.dot{width:14rpx;height:14rpx;border-radius:50%;margin-right:14rpx}.net-dot{background:#55745B}.tax-dot{background:#D9A06C}.social-dot{background:#8FA99A}.house-dot{background:#B8B5A8}.break-label{flex:1;color:#77796E;font-size:25rpx}.break-value{font-size:26rpx;font-weight:600;color:#3B4339}.bar-track{height:12rpx;background:#F0EBE2;border-radius:99rpx;overflow:hidden;margin:8rpx 0 24rpx}.bar-fill{height:100%;background:#789477;border-radius:99rpx}.detail-row{display:flex;justify-content:space-between;padding:15rpx 0;color:#77796E;font-size:25rpx}.detail-row text:last-child{color:#3B4339;font-weight:550}.detail-row.total{font-size:28rpx;font-weight:700}.detail-row.total text{color:#55745B}.notice{color:#969184;font-size:21rpx;line-height:1.8;padding:22rpx 4rpx}.save-btn{margin-top:16rpx}
.tool-list{background:#FFFEFB;border:1rpx solid #EEE8DC;border-radius:24rpx;padding:0 24rpx;margin-top:18rpx;box-shadow:0 6rpx 18rpx rgba(78,67,45,.025)}.list-item{display:flex;align-items:center;gap:18rpx;padding:25rpx 0;border-bottom:1rpx solid #F0EBE2}.list-item:last-child{border-bottom:none}.list-icon{width:66rpx;height:66rpx;flex-shrink:0;border-radius:21rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:700}.green{background:#E4E9D9;color:#55745B}.orange{background:#F5E4D5;color:#A96E4A}.blue{background:#E4E9E6;color:#647D75}.purple{background:#ECE5EF;color:#8A718F}.peach{background:#F3E5DE;color:#B47C67}.list-content{flex:1;min-width:0}.list-title{font-size:27rpx;font-weight:650;color:#3B4339}.list-desc{font-size:22rpx;color:#969184;margin-top:6rpx}.chevron{font-size:40rpx;color:#B6B0A3}.disclaimer{font-size:21rpx;color:#A29D91;line-height:1.8;padding:28rpx 4rpx}
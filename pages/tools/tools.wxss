.tool-list{background:#fff;border-radius:22rpx;padding:0 22rpx;margin-top:18rpx}.list-item{display:flex;align-items:center;gap:18rpx;padding:24rpx 0;border-bottom:1rpx solid #EEF0ED}.list-item:last-child{border-bottom:none}.list-icon{width:66rpx;height:66rpx;flex-shrink:0;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-size:32rpx;font-weight:700}.green{background:#E7F4ED;color:#167B63}.orange{background:#FFF0E2;color:#C67B3B}.blue{background:#E8F1FB;color:#467BB6}.purple{background:#F0EAFB;color:#8663B7}.peach{background:#FCEBE6;color:#C77D64}.list-content{flex:1;min-width:0}.list-title{font-size:27rpx;font-weight:650}.list-desc{font-size:22rpx;color:#858D87;margin-top:6rpx}.chevron{font-size:40rpx;color:#B2B9B4}.disclaimer{font-size:21rpx;color:#969D98;line-height:1.7;padding:28rpx 4rpx}